{
  "name": "queuewise-public-view",
  "version": "26.1.9",
  "description": "An app for BPLO to display the queue number of the clients",
  "author": {
    "name": "Cybernest Solutions",
    "email": "cns@cybernestsolution.com"
  },
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron-build": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\" && electron-builder",
    "test:updater": "node --test electron/updater.test.js"
  },
  "private": true,
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.1",
    "@angular/animations": "^16.2.0",
    "@angular/cli": "~16.2.1",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "dexie": "^4.0.10",
    "electron": "^26.2.1",
    "electron-builder": "^24.6.4",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ngx-socket-io": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.1.3",
    "zone.js": "~0.13.0"
  },
  "build": {
    "asar": true,
    "appId": "com.queuewise.publicview",
    "productName": "Queuewise Public View",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "electron/**",
      "!electron/**/*.test.js",
      "dist/queuewise-public-view/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://updates.cybernestsolution.com/queuewise/public-display/"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon-glow.ico"
    }
  }
}
